generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum Role {
  MANAGER
  SPV
  HUB_LEAD
}

enum HubRole {
  MANAGER
  SPV
  HUB_LEAD
  VIEWER
}

enum CredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// =====================================================
// USER & AUTH
// =====================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String
  createdAt    DateTime @default(now())

  // Legacy fields ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â simpan sementara untuk backward compat
  role                         Role?
  leaderHmsToken               String?

  // Phase 3 ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â Auto-refresh token
  hmsToken                     String?
  hmsRefreshToken              String?
  hmsTokenExpiresAt            DateTime?
  hmsTokenUpdatedAt            DateTime?
  hmsRefreshTokenUpdatedAt     DateTime?

  hubs UserHub[]

  @@index([email])
}

// =====================================================
// FTD BASELINE ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â reset otomatis jam 00:00 WIB
// =====================================================

model HubDailyBaseline {
  id        String   @id @default(cuid())
  hubId     String
  date      String
  ftdBase   Int
  createdAt DateTime @default(now())

  @@unique([hubId, date])
  @@index([hubId, date])
}

// =====================================================
// CLUSTER & HUB
// =====================================================

model Cluster {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  hubs Hub[]
}

model Hub {
  id        String   @id @default(cuid())
  name      String   @unique
  hmsHubId  String   @unique
  region    String   @default("")
  clusterId String
  cluster   Cluster  @relation(fields: [clusterId], references: [id])
  createdAt DateTime @default(now())

  users        UserHub[]
  metrics      HourlyMetric[]
  credentials  HubCredential[]
  pairingCodes PairingCode[]
  cleanFloors  CleanFloorSnapshot[]
  auditLogs    AuditLog[]


  hmsToken              String?
  hmsRefreshToken       String?
  hmsTokenExpiresAt     DateTime?
  hmsTokenUpdatedAt     DateTime?

  @@index([hmsHubId])

}

model UserHub {
  id        String   @id @default(cuid())
  userId    String
  hubId     String
  role      HubRole  @default(VIEWER)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  hub  Hub  @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@unique([userId, hubId])
  @@index([userId])
  @@index([hubId])
}

// =====================================================
// HMS CREDENTIALS (per-hub, encrypted)
// =====================================================

model HubCredential {
  id              String           @id @default(cuid())
  hubId           String
  hub             Hub              @relation(fields: [hubId], references: [id], onDelete: Cascade)
  cookieEncrypted String
  status          CredentialStatus @default(ACTIVE)
  apiIds          Json
  expiresAt       DateTime?
  lastPingAt      DateTime?
  lastErrorMsg    String?
  capturedBy      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([hubId, status])
}

// =====================================================
// PAIRING CODE
// =====================================================

model PairingCode {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String
  hubId     String?
  hub       Hub?      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([code])
  @@index([expiresAt])
}

// =====================================================
// METRICS & SNAPSHOTS
// =====================================================

model HourlyMetric {
  id             String   @id @default(cuid())
  hubId          String
  hub            Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  hourTimestamp  DateTime
  inbound        Int      @default(0)
  outbound       Int      @default(0)
  delivered      Int      @default(0)
  pending        Int      @default(0)
  slaBreach      Int      @default(0)
  activeCouriers Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([hubId, hourTimestamp])
  @@index([hubId, hourTimestamp])
}

model CleanFloorSnapshot {
  id          String   @id @default(cuid())
  hubId       String?
  hub         Hub?     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  facility    String
  date        String
  value       Float
  numerator   Int
  denominator Int
  delivered   Int
  ongoing     Int
  ftd         Int
  others      Int
  capturedAt  DateTime @default(now())

  @@unique([facility, date])
  @@index([hubId, date])
}

// =====================================================
// AUDIT LOG
// =====================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  hubId     String?
  hub       Hub?     @relation(fields: [hubId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([hubId, createdAt])
}

// =====================================================
// METRIC LOCKS
// 08:00 / 12:00 WIB snapshots, create-only per hub + date + kind
// =====================================================

model MetricLock {
  id         String   @id @default(cuid())
  facility   String
  date       String
  kind       String
  value      Float
  payload    Json
  capturedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([facility, date, kind])
  @@index([facility, date])
}