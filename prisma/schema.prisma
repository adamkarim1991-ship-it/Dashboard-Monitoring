generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════

enum Role {
  MANAGER
  SPV
  HUB_LEAD
  VIEWER       // ← tambahan: read-only user
}

// ═══════════════════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════════════════

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  password          String
  // ⚠️ role global DIHAPUS — sekarang role ada di UserHub
  // hmsToken juga DIHAPUS — pindah ke HmsCredential (per-hub)

  // Legacy fields — simpan sementara untuk backward compat
  // Akan dihapus setelah migrasi selesai
  role              Role?          // nullable, deprecated
  hmsToken          String?        // deprecated
  leaderHmsToken    String?        // deprecated
  hmsTokenUpdatedAt DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  hubs              UserHub[]
  ownedHubs         Hub[]     @relation("HubOwner")

  @@index([email])
}

// ═══════════════════════════════════════════════════════
// CLUSTER & HUB
// ═══════════════════════════════════════════════════════

model Cluster {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  hubs      Hub[]
}

model Hub {
  id        String   @id @default(cuid())
  name      String   @unique
  hmsHubId  String   @unique
  region    String   @default("")
  clusterId String
  cluster   Cluster  @relation(fields: [clusterId], references: [id])

  // Owner = user pertama yang bikin/pairing hub ini
  ownerId   String?
  owner     User?    @relation("HubOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserHub[]
  metrics     HourlyMetric[]
  credential  HmsCredential?
  cleanFloors CleanFloorSnapshot[]

  @@index([hmsHubId])
}

// ═══════════════════════════════════════════════════════
// USER ↔ HUB MAPPING (dengan role per-hub)
// ═══════════════════════════════════════════════════════

model UserHub {
  id       String   @id @default(cuid())
  userId   String
  hubId    String
  role     Role     @default(VIEWER)  // ← role PER-HUB
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  hub  Hub  @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@unique([userId, hubId])
  @@index([userId])
  @@index([hubId])
}

// ═══════════════════════════════════════════════════════
// HMS CREDENTIAL (per-hub, encrypted)
// ═══════════════════════════════════════════════════════

model HmsCredential {
  id            String    @id @default(cuid())
  hubId         String    @unique
  hub           Hub       @relation(fields: [hubId], references: [id], onDelete: Cascade)

  // Cookie HMS terenkripsi (AES-256-GCM)
  // Format: "iv:authTag:ciphertext" (hex)
  cookieEnc     String
  apiIds        Json      // { main, cycle1, ops, courier, ... }

  expiresAt     DateTime?
  lastPingAt    DateTime?
  lastError     String?   // pesan error terakhir kalau fetch HMS gagal

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════
// METRICS
// ═══════════════════════════════════════════════════════

model HourlyMetric {
  id             String   @id @default(cuid())
  hubId          String
  hub            Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)

  hourTimestamp  DateTime
  inbound        Int      @default(0)
  outbound       Int      @default(0)
  delivered      Int      @default(0)
  pending        Int      @default(0)
  slaBreach      Int      @default(0)
  activeCouriers Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([hubId, hourTimestamp])
  @@index([hubId, hourTimestamp])
}

model CleanFloorSnapshot {
  id          String   @id @default(cuid())

  // Baru: relasi ke Hub (nullable untuk backward compat)
  hubId       String?
  hub         Hub?     @relation(fields: [hubId], references: [id], onDelete: Cascade)

  // Legacy field — tetap ada untuk data lama
  facility    String

  date        String
  value       Float
  numerator   Int
  denominator Int
  delivered   Int
  ongoing     Int
  ftd         Int
  others      Int
  capturedAt  DateTime @default(now())

  // Legacy unique — untuk backward compat
  @@unique([facility, date])
  // New index untuk query per-hub
  @@index([hubId, date])
}